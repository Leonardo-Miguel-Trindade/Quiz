<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Quiz.Q9"
             Title="Q9">
    <VerticalStackLayout Padding="24" Spacing="20">
        <Label x:Name="lblProgresso"
       Text="Pergunta 9 de 10"
       FontSize="14"
       TextColor="Gray"
       HorizontalOptions="Center" />

        <ProgressBar x:Name="barProgresso" Progress="0" />

        <Border Padding="20"
        StrokeThickness="1"
        Stroke="LightGray">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Label x:Name="lblPergunta"
           Text="Qual operador é utilizado em Java para verificar se dois valores primitivos são estritamente iguais?"
           FontSize="20"
           FontAttributes="Bold"
           HorizontalTextAlignment="Center" />
        </Border>

        <VerticalStackLayout Spacing="6">
            <RadioButton x:Name="rbA" GroupName="alternativas" Content="=" />
            <RadioButton x:Name="rbB" GroupName="alternativas" Content="==" />
            <RadioButton x:Name="rbC" GroupName="alternativas" Content="equals()" />
            <RadioButton x:Name="rbD" GroupName="alternativas" Content="===" />
        </VerticalStackLayout>
        <Label x:Name="lblResultado"
       FontSize="16"
       HorizontalOptions="Center" />


        <Button x:Name="btnConfirmar"
        Text="Confirmar"
        Clicked="OnConfirmarClicked" />

        <Button x:Name="btnProxima"
        Text="Próxima"
        IsVisible="False"
        Clicked="OnNextClicked" />
    </VerticalStackLayout>
</ContentPage>